# Copiar a .env y completar. Nunca commitear .env.
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://deutsch:CONTRASEÑA@localhost:5433/deutsch_dev
# Clave Fernet para credenciales de canales. Generar con:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Para rotar: poner la nueva primero, separadas por coma, y correr rotate.
FIELD_ENCRYPTION_KEY=
# Segunda llave de la regla de oro. Dejar en false salvo decisión explícita.
ALLOW_CHANNEL_WRITES=false
# Email saliente (casilla de Deutsch). Local: consolemail://
# Producción: smtp+tls://usuario:contraseña@servidor:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Sistema Deutsch <no-reply@deutsch.com.ar>
# Tiendanube (app del sistema en Partners; ver docs/runbooks/tiendanube-app.md)
TN_APP_ID=
TN_CLIENT_SECRET=
# Obligatorio para la API: "Nombre (email de contacto)"
TN_USER_AGENT=
# URL pública HTTPS del servidor. Vacía en local: los pedidos entran por conciliación cada N minutos.
TN_WEBHOOKS_BASE_URL=
TN_ORDERS_RECONCILE_MINUTES=5
STOCK_FEED_CHANNEL=tiendanube
# Mercado Libre (app en developers.mercadolibre.com.ar; ver docs/runbooks/mercadolibre-app.md)
ML_APP_ID=
ML_CLIENT_SECRET=
# URL https registrada en la app. Sin servidor: cualquier https; después se pega la URL de vuelta en el panel.
ML_REDIRECT_URI=
ML_POLL_MINUTES=5
# pdf | zpl2 (cuando se confirme la impresora térmica)
ML_LABEL_FORMAT=pdf
# Operación de Mercado Libre (M6)
# Horas sin responder para marcar una pregunta en rojo y avisar
ML_QUESTION_WARNING_HOURS=12
# Solo se avisa por preguntas hechas en los últimos N días (las más viejas se ven en la bandeja, sin aviso)
ML_QUESTION_ALERT_MAX_AGE_DAYS=3
# Avisos antes del plazo de un reclamo (horas, separadas por coma)
ML_CLAIM_WARNING_HOURS=24,4
# Puntaje de salud de ML por debajo del cual la publicación es "calidad baja" (0 a 1)
ML_HEALTH_MIN_SCORE=0.7
# Enlaces a ML: {id} = publicación, {order_id} = venta (a confirmar con la cuenta real)
ML_LISTING_EDIT_URL=https://www.mercadolibre.com.ar/publicaciones/{id}/modificar
ML_CLAIM_URL=https://www.mercadolibre.com.ar/ventas/{order_id}/detalle
# Horas de vigencia de la guía de talles guardada
ML_SIZE_CHART_TTL_HOURS=24
# Preparación y despacho (M5): remitente del rótulo de transporte 10×15 (los completa Deutsch)
SENDER_NAME=
SENDER_TAX_ID=
SENDER_ADDRESS=
SENDER_PHONE=
# Enlace al pedido en el admin de Tiendanube, con {id} = id del pedido. Ej.: https://TIENDA.mitiendanube.com/admin/orders/{id}
TN_ADMIN_ORDER_URL=
# Tope de pedidos por tanda de preparación
FULFILLMENT_MAX_BATCH=60
# Reportes (M7): veces en 0 para figurar en "Se agotan seguido" y ventas de ML por tanda al completar comisiones
REPORTS_STOCKOUT_MIN_TIMES=2
REPORTS_ML_FEES_BATCH=50
SENTRY_DSN=
ENVIRONMENT_NAME=local
MEDIA_ROOT=
