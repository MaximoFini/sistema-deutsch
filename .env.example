# Copiar a .env y completar. Nunca commitear .env.
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://deutsch:CONTRASEÑA@localhost:5433/deutsch_dev
# Clave Fernet para credenciales de canales. Generar con:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Para rotar: poner la nueva primero, separadas por coma, y correr rotate.
FIELD_ENCRYPTION_KEY=
# Segunda llave de la regla de oro. Dejar en false salvo decisión explícita.
ALLOW_CHANNEL_WRITES=false
# Email saliente (casilla de Deutsch). Local: consolemail://
# Producción: smtp+tls://usuario:contraseña@servidor:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Sistema Deutsch <no-reply@deutsch.com.ar>
# Tiendanube (app del sistema en Partners; ver docs/runbooks/tiendanube-app.md)
TN_APP_ID=
TN_CLIENT_SECRET=
# Obligatorio para la API: "Nombre (email de contacto)"
TN_USER_AGENT=
# URL pública HTTPS del servidor. Vacía en local: los pedidos entran por conciliación cada N minutos.
TN_WEBHOOKS_BASE_URL=
TN_ORDERS_RECONCILE_MINUTES=5
STOCK_FEED_CHANNEL=tiendanube
SENTRY_DSN=
ENVIRONMENT_NAME=local
MEDIA_ROOT=
